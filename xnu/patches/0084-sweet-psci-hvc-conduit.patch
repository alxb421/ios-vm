diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 65d73dc..df1b485 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -25,6 +25,12 @@ class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
 static uint32_t sweet_cpus_registered;
 
+/*
+ * PSCI conduit: the phone's EL3 firmware answers SMC. QEMU virt (no EL3) takes HVC and
+ * treats SMC as undefined; tools/mkadt.py --qemu sets psci-method = "hvc" on the CPU nodes.
+ */
+static bool sweet_psci_hvc;
+
 /* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
 static int32_t
 sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
@@ -33,9 +39,15 @@ sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
 	register uint64_t x1 __asm__("x1") = target;
 	register uint64_t x2 __asm__("x2") = entry;
 	register uint64_t x3 __asm__("x3") = context;
-	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
-	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
-	    "x14", "x15", "x16", "x17", "cc", "memory");
+	if (sweet_psci_hvc) {
+		__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	} else {
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	}
 	return (int32_t)x0;
 }
 
@@ -70,6 +82,10 @@ SweetCPU::start(IOService *provider)
 		return false;
 	}
 	const ml_topology_cpu_t *cpu = &topology->cpus[logical->unsigned32BitValue()];
+	OSData *method = OSDynamicCast(OSData, provider->getProperty("psci-method"));
+	if (method != NULL && method->getLength() >= 3 && memcmp(method->getBytesNoCopy(), "hvc", 3) == 0) {
+		sweet_psci_hvc = true;
+	}
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
